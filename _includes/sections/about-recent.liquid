{% comment %}
  About Page — Recent Articles (fetched by JS) + Physics Canvas
  Data source: _data/about.yml (canvas)
{% endcomment %}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h3 class="font-weight-bold">{{ site.data.about.labels.recent_articles.title }}</h3>
        <p class="text-muted">{{ site.data.about.labels.recent_articles.subtitle }}</p>
    </div>
</div>

<div id="recent-pubs-container" class="recent-pubs-wrapper">
    <div class="text-center py-5">
        <i class="fas fa-spinner fa-spin fa-2x text-muted"></i>
    </div>
</div>

<div class="row mt-2 mb-5">
    <div class="col-12 text-center">
        <a href="{{ '/publications/' | relative_url }}" class="btn btn-outline-light rounded-pill px-4">
            {{ site.data.about.labels.buttons.view_all }} <i class="fas fa-arrow-right ml-1"></i>
        </a>
    </div>
</div>

<hr class="my-5">

<div class="canvas-container mt-3">
    <canvas id="physicsCanvas"></canvas>
    <div class="canvas-overlay">
        <h2>{{ site.data.about.canvas.title }}</h2>
        <p>{{ site.data.about.canvas.subtitle }}</p>
    </div>
</div>

<script src="{{ '/assets/js/pages/about.js' | relative_url }}"></script>
