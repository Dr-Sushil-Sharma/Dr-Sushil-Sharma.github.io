{% comment %}
  Python Course Page
{% endcomment %}

<link rel="stylesheet" href="{{ '/assets/css/pages/python-course.css' | relative_url }}">


<div id="login-overlay">
    <div class="login-box">
        <h2 style="color: #fff; margin-bottom: 0.5rem; font-weight: 700;">{{ site.data.python_course.labels.login.title }}</h2>
        <p style="color: #aaa; font-size: 0.95rem; margin-bottom: 1.5rem;">
            <i class="fas fa-lock text-primary mr-1"></i> 
            {{ site.data.python_course.labels.login.subtitle }}
        </p>
        
        <div class="login-input-group">
            <input type="password" id="passwordInput" class="login-input" placeholder="{{ site.data.python_course.labels.login.placeholder }}" onkeyup="if(event.key==='Enter') verifyPassword()">
            <span class="toggle-password" onclick="togglePasswordVisibility()">
                <i class="fas fa-eye" id="eyeIcon"></i>
            </span>
        </div>

        <button class="login-btn" onclick="verifyPassword()">{{ site.data.python_course.labels.login.button }}</button>

        <div id="errorMsg" class="error-msg">
            <strong>{{ site.data.python_course.labels.login.error_msg }}</strong><br>
            {{ site.data.python_course.labels.login.contact_text }}<br>
            <a href="mailto:{{ site.data.python_course.labels.login.contact_email }}" class="contact-link">{{ site.data.python_course.labels.login.contact_email }}</a>
        </div>
    </div>

</div>

<!-- Particle Background Container -->
<div id="particles-js"></div>
<!-- Particles.js CDN - MUST be outside protected content to load -->
<script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
<!-- Global Snake Cursor Container -->
<div id="snake-cursor" style="pointer-events: none; position: fixed; top:0; left:0; width:100%; height:100%; overflow:hidden; z-index:9999; display:none;"></div>

<div id="protected-content" style="display:none;">

    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Particles.js loaded outside protected-content -->

    <!-- HEADER SECTION -->
    <div class="course-header mb-5">
        <div class="row align-items-center">
            
            <!-- Left Column: Compact Text (Col-5) -->
            <div class="col-md-5 mb-4 mb-md-0 text-center text-md-left" style="position: relative;">
                
                <h1 class="display-4 font-weight-bold gradient-text mb-2" id="hacker-title" data-value="{{ site.data.python_course.page_info.title }}">{{ site.data.python_course.page_info.title }}</h1>
                <p class="lead text-muted mb-3" style="font-size: 1.1rem;">
                    {{ site.data.python_course.page_info.description }}
                </p>
                <div class="course-meta mb-4">
                    {% for instr in site.data.python_course.page_info.instructors %}
                    <div class="mb-2"><i class="{{ instr.icon }} mr-2" style="width:20px;"></i><strong class="{{ instr.class }}">{{ instr.name }}</strong></div>
                    {% endfor %}
                    <div class="mb-0 d-flex align-items-center justify-content-center justify-content-md-start">
                        <i class="{{ site.data.python_course.page_info.institution.icon }} mr-2"></i>
                        <strong>{{ site.data.python_course.page_info.institution.name }}</strong>
                    </div>
                </div>
                <div>
                    <a href="#lectures" class="btn btn-primary px-4 mr-2 rounded-pill shadow-sm">{{ site.data.python_course.labels.buttons.view_lectures }}</a>
                    <a href="#tutorials" class="btn btn-outline-success px-4 rounded-pill">{{ site.data.python_course.labels.buttons.tutorials }}</a>
                </div>
            </div>
            
            <!-- Right Column: Terminal (Col-7, Balanced) -->
            <div class="col-md-7">
                <div class="terminal-window shadow-lg" onclick="document.getElementById('term-input').focus()">
                    <div class="terminal-bar">
                        <div class="dot red"></div>
                        <div class="dot yellow"></div>
                        <div class="dot green"></div>
                        <span class="terminal-title">{{ site.data.python_course.labels.terminal.title }}</span>
                    </div>
                    <div class="terminal-body" id="terminal-body">
                        <div class="terminal-output" id="terminal-output">
                            {% for line in site.data.python_course.labels.terminal.output_lines %}
                            <span class="text-muted">{{ line }}</span><br>
                            {% endfor %}
                            <!-- Auto-type will happen here -->
                        </div>
                        <div class="terminal-input-line">
                            <span class="terminal-prompt">>>></span>
                            <input type="text" id="term-input" class="terminal-input" autocomplete="off" spellcheck="false">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5">

    <!-- QUICK STATS -->
    <div class="row mb-5 text-center justify-content-center">
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-number text-primary">{{ site.data.python_course.stats.lectures }}</div>
                <div class="stat-label">{{ site.data.python_course.labels.stats.lectures }}</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-number text-success">{{ site.data.python_course.stats.tutorials }}</div>
                <div class="stat-label">{{ site.data.python_course.labels.stats.tutorials }}</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-number text-warning">{{ site.data.python_course.stats.weeks }}</div>
                <div class="stat-label">{{ site.data.python_course.labels.stats.weeks }}</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <div class="stat-number text-info">✓</div>
                <div class="stat-label">{{ site.data.python_course.labels.stats.solutions }}</div>
            </div>
        </div>
        <!-- Visitor Counter -->
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card visitor">
                <div class="stat-number visitor-count" id="visitor-count">...</div>
                <div class="stat-label">{{ site.data.python_course.labels.stats.learners }}</div>
            </div>
        </div>
    </div>
    
    <!-- Smart Welcome Message -->
    <div class="container text-center mb-5">
        <div id="smart-welcome-msg" class="smart-welcome" style="display:none;">
            <!-- Message injected via JS -->
        </div>
    </div>

    <!-- LECTURES SECTION -->
    <div id="lectures" class="mb-5">
        <h3 class="font-weight-bold mb-4"><i class="fas fa-chalkboard-teacher mr-2 text-primary"></i>{{ site.data.python_course.labels.sections.lectures.title }}</h3>
        <p class="text-muted mb-4">{{ site.data.python_course.labels.sections.lectures.subtitle }}</p>

        <div class="accordion" id="lecturesAccordion">

            {% for lec in site.data.python_course.lectures %}
            <div class="lecture-card mb-3">
                <div class="lecture-header" data-toggle="collapse" data-target="#{{ lec.id }}">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="lecture-number">{{ lec.number }}</span>
                            <span class="lecture-title">{{ lec.title }}</span>
                        </div>
                        <div class="lecture-meta">
                            <span class="badge badge-light border mr-2">{{ lec.week }}</span>
                            <div class="btn-group-viewer">
                                <button class="btn btn-sm btn-info btn-viewer" onclick="event.stopPropagation(); openPdfViewer('{{ lec.pdf_url }}', 'Lecture {{ lec.number }}: {{ lec.title }}');">
                                    <i class="fas fa-eye"></i> {{ site.data.python_course.labels.buttons.view }}
                                </button>
                                <a href="{{ lec.pdf_url }}" class="btn btn-sm btn-primary btn-viewer" onclick="event.stopPropagation();">
                                    <i class="fas fa-download"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="{{ lec.id }}" class="collapse" data-parent="#lecturesAccordion">
                    <div class="lecture-body">
                        <p><strong>{{ lec.description }}</strong></p>
                        <div class="row">
                            {% if lec.custom_layout %}
                                {% for block in lec.blocks %}
                                <div class="col-md-4">
                                    <h6 class="text-{{ block.color }}"><i class="{{ block.icon }} mr-1"></i> {{ block.title }}</h6>
                                    <p class="small">{{ block.desc }}</p>
                                </div>
                                {% endfor %}
                            {% else %}
                                <div class="col-md-6">
                                    <ul class="topic-list-detailed">
                                        {% for topic in lec.topics_col1 %}
                                        <li><i class="fas fa-check text-success mr-2"></i>{{ topic }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <ul class="topic-list-detailed">
                                        {% for topic in lec.topics_col2 %}
                                        <li><i class="fas fa-check text-success mr-2"></i>{{ topic }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}
                        </div>
                        {% if lec.key_concepts %}
                        <p class="text-muted small mt-2"><strong>{{ site.data.python_course.labels.sections.lectures.key_concepts }}</strong> {{ lec.key_concepts }}</p>
                        {% endif %}
                        <div class="mt-3 small pt-2">
                            <i class="fas fa-link text-muted mr-1"></i> <strong>{{ site.data.python_course.labels.sections.lectures.practice }}</strong>
                            {% for link in lec.practice_links %}
                            <a href="{{ link.url }}" target="_blank" class="mr-2">{{ link.title }}</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}

        </div>
    </div>

    <hr class="my-5">

    <!-- TUTORIALS SECTION -->
    <div id="tutorials" class="mb-5">
        <h3 class="font-weight-bold mb-4"><i class="fas fa-laptop-code mr-2 text-success"></i>{{ site.data.python_course.labels.sections.tutorials.title }} <span class="badge badge-success ml-2">{{ site.data.python_course.labels.sections.tutorials.badge }}</span></h3>
        <p class="text-muted mb-4">{{ site.data.python_course.labels.sections.tutorials.subtitle }}</p>

        <div class="row">

            {% for tut in site.data.python_course.tutorials %}
            <div class="col-12 mb-4">
                <div class="tutorial-card {% if tut.featured %}featured{% endif %}">
                    <div class="tutorial-header">
                        <span class="tutorial-number">{{ tut.number }}</span>
                        <span class="difficulty-badge">{{ tut.difficulty }}</span>
                    </div>
                    <div class="tutorial-content">
                        <h5 class="tutorial-title">{{ tut.title }}</h5>
                        <p class="tutorial-desc">{{ tut.desc }}</p>
                        {% if tut.problems %}
                        <div class="practice-problems">
                            <small><i class="fas fa-puzzle-piece mr-1"></i> {{ tut.problems }}</small>
                        </div>
                        {% else %}
                        <span class="format-badge pdf"><i class="fas fa-file-pdf"></i> PDF</span>
                        {% endif %}
                        <div class="practice-links mt-2 small">
                            {% for link in tut.practice_links %}
                             <a href="{{ link.url }}" target="_blank" class="mr-2"><i class="fas fa-external-link-alt text-muted mr-1"></i> {{ link.title }}</a>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="tutorial-footer">
                        {% if tut.has_jupyter %}
                        <span class="format-badge jupyter"><i class="fas fa-book"></i> Jupyter</span>
                        <div class="btn-group-viewer">
                            <button class="btn btn-sm btn-colab btn-viewer" onclick="openInColab('{{ tut.notebook_url }}');" title="Open in Colab">
                                <i class="fab fa-google"></i> {{ site.data.python_course.labels.buttons.open_colab }}
                            </button>
                            <a href="{{ tut.notebook_url }}" class="btn btn-sm btn-outline-success btn-viewer" title="Download">
                                <i class="fas fa-download"></i>
                            </a>
                        </div>
                        {% elsif tut.has_pdf %}
                        <div class="btn-group-viewer">
                            <button class="btn btn-sm btn-info btn-viewer" onclick="openPdfViewer('{{ tut.pdf_url }}', 'Tutorial {{ tut.number }}: {{ tut.title }}');">
                                <i class="fas fa-eye"></i> {{ site.data.python_course.labels.buttons.view }}
                            </button>
                            <a href="{{ tut.pdf_url }}" class="btn btn-sm btn-outline-primary btn-viewer">
                                <i class="fas fa-download"></i> {{ site.data.python_course.labels.buttons.download }}
                            </a>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}

        </div>

        <!-- HOW TO USE SECTION -->
        <div class="how-to-use-box mt-5">
            <h5 class="font-weight-bold mb-4"><i class="fab fa-google mr-2"></i>{{ site.data.python_course.labels.sections.how_to_use.title }}</h5>
            <p class="text-muted mb-4">{{ site.data.python_course.labels.sections.how_to_use.subtitle }}</p>

            <div class="colab-steps">
                <div class="colab-step">
                    <div class="colab-step-number" style="background: linear-gradient(135deg, #F9AB00, #E37400);"><i class="fab fa-google"></i></div>
                    <div class="colab-step-content">
                        <h6><i class="fab fa-google mr-2" style="color: #F9AB00;"></i>{{ site.data.python_course.labels.buttons.open_colab }}</h6>
                        <p>{{ site.data.python_course.labels.sections.how_to_use.colab_desc }}</p>
                    </div>
                </div>

                <div class="colab-step">
                    <div class="colab-step-number" style="background: linear-gradient(135deg, #28a745, #20c997);"><i class="fas fa-download"></i></div>
                    <div class="colab-step-content">
                        <h6><i class="fas fa-download mr-2 text-success"></i>{{ site.data.python_course.labels.buttons.download }}</h6>
                        <p>{{ site.data.python_course.labels.sections.how_to_use.download_desc }}</p>
                    </div>
                </div>
            </div>

            <div class="colab-tip mt-4">
                <i class="fas fa-exclamation-triangle mr-2" style="color: #F9AB00;"></i>
                {{ site.data.python_course.labels.sections.how_to_use.remember }}
            </div>
        </div>

    </div>

    <hr class="my-5">

    <!-- LEARNING PATH -->
    <div class="mb-5">
        <h3 class="font-weight-bold mb-4"><i class="fas fa-road mr-2 text-info"></i>{{ site.data.python_course.labels.sections.learning_path.title }}</h3>
        <p class="text-muted mb-4">{{ site.data.python_course.labels.sections.learning_path.subtitle }}</p>

        <div class="learning-journey">

            {% for step in site.data.python_course.learning_path %}
            <div class="journey-step {% if step.is_final %}final{% endif %}" onclick="toggleStep(this)">
                <div class="step-icon-wrapper" {% if step.is_final %}style="border-color: #28a745; color: #28a745;"{% endif %}>{{ step.step }}</div>
                <div class="step-content">
                    <h5 class="step-title">{{ step.title }}</h5>
                    <div class="step-materials">
                         <span class="material-tag lecture" {% if step.is_final %}style="background: rgba(40,167,69,0.1); color:#28a745;"{% endif %}><i class="fas fa-chalkboard-teacher"></i> {{ step.lecture }}</span>
                        <span class="material-tag tutorial"><i class="fas fa-laptop-code"></i> {{ step.tutorial }}</span>
                    </div>
                    <p class="step-topics">{{ step.topics }}</p>
                    <div class="step-details">
                         <ul class="small mb-2 ml-3">
                            {% for bullet in step.bullets %}
                            <li>{{ bullet }}</li>
                            {% endfor %}
                        </ul>
                        <div class="text-right">
                            <button class="btn btn-sm btn-outline-danger rounded-pill py-0 mr-1" onclick="event.stopPropagation(); openVideo('{{ step.video }}')"><i class="fab fa-youtube"></i> {{ site.data.python_course.labels.buttons.watch }}</button>
                            <button class="btn btn-sm {% if step.is_final %}btn-outline-success{% else %}btn-outline-primary{% endif %} rounded-pill py-0" onclick="event.stopPropagation(); scrollToSection('{{ step.section }}')">{{ site.data.python_course.labels.buttons.go_to_materials }}</button>
                        </div>
                    </div>
                </div>
                <div class="step-arrow"><i class="fas fa-chevron-right"></i></div>
            </div>
            {% endfor %}

        </div>
    </div>

    <hr class="my-5">

    <!-- RECOMMENDED YOUTUBE COURSES -->
    <div class="mb-5">
        <h3 class="font-weight-bold mb-4 text-center"><i class="fab fa-youtube mr-2 text-danger"></i>{{ site.data.python_course.labels.sections.youtube.title }}</h3>
        <p class="text-muted text-center mb-5">{{ site.data.python_course.labels.sections.youtube.subtitle }}</p>
        
        <div class="row">
            {% for course in site.data.python_course.youtube_courses %}
            <div class="col-md-4 mb-4">
                <div class="card course-card h-100" {% if course.is_series != true %}onclick="window.open('{{ course.url }}', '_blank')" style="cursor: pointer;"{% endif %}>
                    <div class="course-thumb-wrapper">
                        <img src="{{ course.thumbnail }}" class="course-thumb" alt="{{ course.author }}">
                        <div class="play-overlay"><i class="fas fa-play-circle play-icon-lg"></i></div>
                        <div class="duration-badge">{{ course.duration }}</div>
                        {% if course.is_series %}
                         <a href="{{ course.url }}" target="_blank" class="stretched-link"></a>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <h5 class="font-weight-bold text-white mb-2">{{ course.title }}</h5>
                        <p class="text-muted small mb-0"><i class="fas fa-user-circle mr-1"></i> {{ course.author }}</p>
                        <p class="text-warning small font-weight-bold mb-0 mt-2"><i class="far fa-clock mr-1"></i> {{ course.duration }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    
    <hr class="my-5">

    <!-- RESOURCES -->
    <div class="row mb-5">
        <div class="col-md-6 mb-4">
            <h5 class="font-weight-bold mb-3"><i class="fas fa-tools mr-2 text-warning"></i>{{ site.data.python_course.labels.sections.resources.prereq_title }}</h5>
            <ul class="resource-list">
                {% for pre in site.data.python_course.resources.prerequisites %}
                <li><i class="fas fa-check-circle text-success mr-2"></i>{{ pre }}</li>
                {% endfor %}
            </ul>
        </div>
        <div class="col-md-6 mb-4">
            <h5 class="font-weight-bold mb-3"><i class="fas fa-book-open mr-2 text-info"></i>{{ site.data.python_course.labels.sections.resources.rec_title }}</h5>
            <ul class="resource-list">
                {% for res in site.data.python_course.resources.recommended %}
                <li><a href="{{ res.url }}" target="_blank"><i class="fas fa-external-link-alt mr-2"></i>{{ res.name }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <!-- TIPS -->
    <div class="tips-box mb-5">
        <h5 class="font-weight-bold mb-3"><i class="fas fa-lightbulb mr-2"></i>{{ site.data.python_course.labels.sections.tips.title }}</h5>
        <div class="row">
            <div class="col-md-6">
                <ul class="mb-0">
                    {% for tip in site.data.python_course.tips.col1 %}
                    <li>{{ tip }}</li>
                    {% endfor %}
                </ul>
            </div>
            <div class="col-md-6">
                <ul class="mb-0">
                    {% for tip in site.data.python_course.tips.col2 %}
                    <li>{{ tip }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12 text-center">
            <a href="/teaching/" class="btn btn-link text-muted"><i class="fas fa-arrow-left"></i> {{ site.data.python_course.labels.buttons.back_to_teaching }}</a>
        </div>
    </div>

    

    

    <!-- PYTHON OUTPUT CHALLENGE GAME -->
    <div class="game-section">
        <div class="text-center mb-4">
            <h4 class="font-weight-bold" style="color: #333;">{{ site.data.python_course.labels.game.title }}</h4>
            <p class="text-muted">{{ site.data.python_course.labels.game.subtitle }}</p>
        </div>

        <div class="game-terminal">
            <div class="game-header">
                <div class="game-dot dot-red"></div>
                <div class="game-dot dot-yellow"></div>
                <div class="game-dot dot-green"></div>
                <div class="game-title">{{ site.data.python_course.labels.game.prompt }}</div>
            </div>

            <div class="game-content" id="game-ui">
                <div class="text-center py-5">
                    <h5 class="text-white mb-4">{{ site.data.python_course.labels.game.choose }}</h5>
                    <div class="d-flex flex-column align-items-center">
                        <button class="btn btn-primary px-4 py-2 m-2" style="width: 280px;" onclick="startGame(1)">
                            <i class="fas fa-terminal mr-2"></i> {{ site.data.python_course.labels.game.level1 }}
                        </button>
                        <button class="btn btn-outline-info px-4 py-2 m-2" style="width: 280px;" onclick="startGame(2)">
                            <i class="fas fa-code mr-2"></i> {{ site.data.python_course.labels.game.level2 }}
                        </button>
                        <button class="btn btn-outline-danger px-4 py-2 m-2" style="width: 280px;" onclick="startGame(3)">
                            <i class="fas fa-skull mr-2"></i> {{ site.data.python_course.labels.game.level3 }}
                        </button>
                    </div>
                </div>
            </div>

            <!-- Hidden Result Overlay -->
            <div id="game-overlay" class="game-overlay hidden">
                <h3 class="text-white mb-3" id="final-message">{{ site.data.python_course.labels.game.game_over }}</h3>
                <div class="score-display display-4 mb-4" id="final-score">0/5</div>
                <div class="d-flex justify-content-center">
                    <button class="btn btn-outline-light mr-3" onclick="startGame()"><i class="fas fa-redo mr-2"></i>{{ site.data.python_course.labels.game.play_again }}</button>
                    <button id="share-btn" class="btn btn-primary" onclick="shareResult()"><i class="fas fa-share-alt mr-2"></i>{{ site.data.python_course.labels.game.share }}</button>
                </div>
            </div>
        </div>
    </div>

    


<!-- Video Viewer Modal -->
<div id="videoModal" class="video-modal" onclick="closeVideoModal()">
    <div class="video-modal-content" onclick="event.stopPropagation()">
        <span class="close-video" onclick="closeVideoModal()">&times;</span>
        <div class="video-container">
            <iframe id="videoFrame" src="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>
</div>

<!-- PDF Viewer Modal -->
<div id="pdfViewerModal" class="pdf-viewer-modal">
    <div class="pdf-viewer-container">
        <div class="pdf-viewer-header">
            <h5 id="pdfViewerTitle">PDF Viewer</h5>
            <button class="pdf-viewer-close" onclick="closePdfViewer()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <iframe id="pdfFrame" class="pdf-frame"></iframe>
    </div>
</div>

<script src="{{ '/assets/js/pages/python-course.js' | relative_url }}"></script>
