{% comment %}
  Speaking Page — Full template
  Data source: _data/speaking.yml
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/css/pages/speaking.css' | relative_url }}">

<!-- INTRO -->
<div class="row mb-4">
    <div class="col-sm-12">
        <p class="lead">{{ site.data.speaking.intro }}</p>
    </div>
</div>

<!-- CAROUSEL -->
<div id="speakingCarousel" class="carousel slide mb-5 shadow-lg rounded-lg overflow-hidden" data-ride="carousel">
  <ol class="carousel-indicators">
    {% for i in site.data.speaking.carousel.images %}
    <li data-target="#speakingCarousel" data-slide-to="{{ forloop.index0 }}" class="{% if forloop.first %}active{% endif %}"></li>
    {% endfor %}
  </ol>
  <div class="carousel-inner">
    {% for i in site.data.speaking.carousel.images %}
    <div class="carousel-item {% if forloop.first %}active{% endif %}">
      <img src="{{ '/assets/img/PhotosFB/' | append: i | append: '.jpg' | relative_url }}" class="d-block w-100 carousel-img" alt="Speaking Engagement {{ i }}">
      {% if forloop.first %}
      <div class="carousel-caption d-none d-md-block">
        <p class="carousel-text-bg">{{ site.data.speaking.carousel.caption }}</p>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  <a class="carousel-control-prev" href="#speakingCarousel" role="button" data-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="sr-only">Previous</span>
  </a>
  <a class="carousel-control-next" href="#speakingCarousel" role="button" data-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="sr-only">Next</span>
  </a>
</div>

<!-- TABS -->
<ul class="nav nav-pills mb-4 justify-content-center" id="speaking-tabs" role="tablist">
  {% for tab in site.data.speaking.tabs %}
  <li class="nav-item">
    <a class="nav-link {% if tab.active %}active{% endif %}" id="{{ tab.id }}-tab" data-toggle="pill" href="#{{ tab.id }}" role="tab" aria-controls="{{ tab.id }}" aria-selected="{{ tab.active | default: false }}">
        <i class="{{ tab.icon }}"></i> {{ tab.label }}
    </a>
  </li>
  {% endfor %}
</ul>

<div class="tab-content mb-5" id="speaking-tab-content">

  <!-- KEYNOTES -->
  <div class="tab-pane fade show active" id="keynote" role="tabpanel" aria-labelledby="keynote-tab">
    <div class="talk-list">
      {% for talk in site.data.speaking.keynotes %}
      <div class="talk-card{% if talk.featured %} featured{% endif %}">
        <div class="talk-year">{{ talk.year }}</div>
        <div class="talk-details">
          <h5 class="talk-title">{{ talk.title }}</h5>
          <p class="talk-event">{% if talk.featured %}<i class="fas fa-star text-warning"></i> {% endif %}{{ talk.event }}</p>
          <div class="talk-meta">
            <span><i class="fas fa-map-marker-alt"></i> {{ talk.location }}</span>
            {% if talk.date %}<span><i class="far fa-calendar-alt"></i> {{ talk.date }}</span>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- TALKS -->
  <div class="tab-pane fade" id="invited" role="tabpanel" aria-labelledby="invited-tab">
    <div class="talk-list">
      {% for talk in site.data.speaking.talks %}
      <div class="talk-card">
        <div class="talk-year">{{ talk.year }}</div>
        <div class="talk-details">
          <h5 class="talk-title">{{ talk.title }}</h5>
          <p class="talk-event">{{ talk.event }}</p>
          <div class="talk-meta">
            <span><i class="fas fa-map-marker-alt"></i> {{ talk.location }}</span>
            {% if talk.date %}<span><i class="far fa-calendar-alt"></i> {{ talk.date }}</span>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- POSTERS -->
  <div class="tab-pane fade" id="conference" role="tabpanel" aria-labelledby="conference-tab">
    <div class="talk-list">
      {% for talk in site.data.speaking.posters %}
      <div class="talk-card">
        <div class="talk-year">{{ talk.year }}</div>
        <div class="talk-details">
          <h5 class="talk-title">{{ talk.title }}</h5>
          <p class="talk-event">{{ talk.event }}</p>
          <div class="talk-meta">
            <span><i class="fas fa-map-marker-alt"></i> {{ talk.location }}</span>
            {% if talk.date %}<span><i class="far fa-calendar-alt"></i> {{ talk.date }}</span>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- VISITS -->
  <div class="tab-pane fade" id="visits" role="tabpanel" aria-labelledby="visits-tab">
    <div class="talk-list">
      {% for talk in site.data.speaking.visits %}
      <div class="talk-card{% if talk.featured %} featured{% endif %}">
        <div class="talk-year">{{ talk.year }}</div>
        <div class="talk-details">
          <h5 class="talk-title">{{ talk.title }}</h5>
          <p class="talk-event">{{ talk.event }}</p>
          <div class="talk-meta">
            <span><i class="fas fa-map-marker-alt"></i> {{ talk.location }}</span>
            {% if talk.date %}<span><i class="far fa-calendar-alt"></i> {{ talk.date }}</span>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

</div>

<hr class="my-5">

<!-- GLOBE -->
<div class="row">
    <div class="col-12 text-center">
        <h3 class="mb-2 font-weight-bold" style="font-family: 'Orbitron', sans-serif;">{{ site.data.speaking.globe.title }}</h3>
        <p class="text-muted small">
            <i class="fas fa-globe-americas"></i> {{ site.data.speaking.globe.instructions }}
        </p>
    </div>
</div>

<div id="globe-container"></div>

<script src="//unpkg.com/globe.gl"></script>
<script src="{{ '/assets/js/pages/speaking.js' | relative_url }}"></script>
